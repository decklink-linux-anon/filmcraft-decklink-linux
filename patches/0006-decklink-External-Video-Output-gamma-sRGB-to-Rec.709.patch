+
+#[test]
+fn bt1886_is_the_default_transfer_and_as_is_the_plain_conversion() {
+    assert_eq!(Transfer::default(), Transfer::SrgbToBt1886);
+    for v in [0u8, 25, 128, 200, 255] {
+        assert_eq!(uyvy_with([v, v / 2, 255 - v], Transfer::AsIs), uyvy_of([v, v / 2, 255 - v]));
+    }
+}
+
+#[test]
+fn srgb_to_bt1886_keeps_black_white_and_primaries_and_lifts_the_shadows() {
+    let t = Transfer::SrgbToBt1886;
+    assert_eq!(uyvy_with([0, 0, 0], t), [128, 16, 128, 16]);
+    assert_eq!(uyvy_with([255, 255, 255], t), [128, 235, 128, 235]);
+    assert_eq!(uyvy_with([255, 0, 0], t), uyvy_of([255, 0, 0]));
+    // mid grey: sRGB 128 is 21.6 % linear, 0.528 in gamma 2.4: Y' 16 + 219 * 0.528 = 131.6
+    let grey = uyvy_with([128, 128, 128], t);
+    assert!((131..=132).contains(&grey[1]), "{grey:?}");
+    assert_eq!((grey[0], grey[2]), (128, 128), "greys stay neutral");
+    // dark grey: sRGB 25 is ~1 % linear, 0.146 in gamma 2.4 (Y' 48; unchanged it is 37)
+    assert_eq!(uyvy_with([25, 25, 25], t)[1], 48);
+    assert_eq!(uyvy_of([25, 25, 25])[1], 37);
+    // monotonic
+    let ys: Vec<u8> = (0..=255u8).map(|v| uyvy_with([v, v, v], t)[1]).collect();
+    assert!(ys.windows(2).all(|w| w[0] <= w[1]));
+}
