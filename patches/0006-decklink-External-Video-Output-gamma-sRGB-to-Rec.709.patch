         assert!(!e.to_string().is_empty());
     }
 }
+
+fn uyvy_with(rgb: [u8; 3], transfer: Transfer) -> [u8; 4] {
+    let src = [rgb[0], rgb[1], rgb[2], 255, rgb[0], rgb[1], rgb[2], 255];
+    let mut dst = [0u8; 4];
+    rgba_to_uyvy_with(&src, 2, 1, &mut dst, 2, 1, transfer);
+    dst
