+/// How the picture's R'G'B' code values are encoded for the card.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Transfer {
+    /// Sent unchanged: the sRGB-encoded values go out as BT.709 code values.
+    AsIs,
+    /// The default. Decoded with the sRGB EOTF and re-encoded for a BT.1886 display (pure gamma 2.4), so a
+    /// Rec.709 monitor or TV shows what an sRGB computer monitor shows: `out = sRGB_EOTF(v)^(1/2.4)`.
+    #[default]
+    SrgbToBt1886,
+}
+
+impl Transfer {
+    /// The re-encoded value of an 8-bit code value `v`, 0–1.
+    fn encode(self, v: usize) -> f64 {
+        let x = v as f64 / 255.0;
+        match self {
+            Self::AsIs => x,
+            Self::SrgbToBt1886 => {
+                let lin = if x <= 0.04045 { x / 12.92 } else { ((x + 0.055) / 1.055).powf(2.4) };
+                lin.powf(1.0 / 2.4)
+            }
+        }
+    }
+}
