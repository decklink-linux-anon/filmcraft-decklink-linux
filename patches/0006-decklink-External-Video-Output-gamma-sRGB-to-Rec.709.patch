+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum OutputTransfer {
+    /// `asIs`: the sRGB code values unchanged.
+    AsIs,
+    /// `srgbToBt1886` (default): decoded from sRGB and re-encoded for a BT.1886 (gamma 2.4)
