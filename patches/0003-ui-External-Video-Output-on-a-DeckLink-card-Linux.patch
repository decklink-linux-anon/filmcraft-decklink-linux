@@ -0,0 +1,185 @@
+//! External Video Output (Settings ▸ Playback ▸ Enable External Video Output): the Program
+//! monitor's frames reach the host's video output at the output size, paused and while playing;
+//! with the setting off, or with no card, nothing is opened and nothing fails.
+
+use std::sync::{Arc, Mutex};
+
+use egui_kittest::Harness;
+use filmcraft_engine::Session;
+use filmcraft_time::Tick;
+use filmcraft_ui_egui::frames::Rgba;
+use filmcraft_ui_egui::{FilmcraftApp, VideoOutput, VideoOutputOpener};
+use serde_json::json;
+
+#[derive(Default)]
+struct Log {
+    opened: usize,
+    closed: usize,
+    /// (width, height, first pixel) of each frame sent
+    frames: Vec<(usize, usize, [u8; 4])>,
+}
+
+struct FakeCard(Arc<Mutex<Log>>);
+
+impl VideoOutput for FakeCard {
+    fn name(&self) -> String {
+        "fake card".into()
+    }
+    fn send(&self, frame: Arc<Rgba>) {
+        let px = [frame.px[0], frame.px[1], frame.px[2], frame.px[3]];
+        self.0.lock().unwrap().frames.push((frame.w, frame.h, px));
+    }
+}
+
+impl Drop for FakeCard {
+    fn drop(&mut self) {
+        self.0.lock().unwrap().closed += 1;
+    }
+}
+
+fn opener(log: &Arc<Mutex<Log>>, works: bool) -> VideoOutputOpener {
+    let log = log.clone();
+    Box::new(move || {
+        log.lock().unwrap().opened += 1;
+        if works { Ok(Box::new(FakeCard(log.clone())) as Box<dyn VideoOutput>) } else { Err("no DeckLink device found".into()) }
+    })
+}
+
+fn harness(on: bool, works: bool) -> (Harness<'static, FilmcraftApp>, Arc<Mutex<Log>>) {
+    harness_gpu(on, works, true)
+}
+
+fn harness_gpu(on: bool, works: bool, gpu: bool) -> (Harness<'static, FilmcraftApp>, Arc<Mutex<Log>>) {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    s.set_playhead(Tick::ZERO);
+    s.prefs.playback.enable_transmit = on;
+    let log = Arc::new(Mutex::new(Log::default()));
+    let mut app = FilmcraftApp::new(s);
+    app.hooks.open_video_output = Some(opener(&log, works));
+    app.transmit_mut().set_gpu(gpu);
+    let h = Harness::builder().with_size(egui::vec2(1280.0, 800.0)).with_step_dt(0.04).build_eframe(move |_cc| app);
+    (h, log)
+}
+
+/// Step (real time passes for the frame workers) until `done` or ~20 s.
+fn step_until(h: &mut Harness<'static, FilmcraftApp>, log: &Arc<Mutex<Log>>, done: impl Fn(&Log) -> bool) {
+    for _ in 0..1000 {
+        h.step();
+        if done(&log.lock().unwrap()) {
+            return;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(20));
+    }
+}
+
+#[test]
+fn with_the_setting_off_nothing_is_opened() {
+    let (mut h, log) = harness(false, true);
+    for _ in 0..10 {
+        h.step();
+    }
+    let l = log.lock().unwrap();
+    assert_eq!((l.opened, l.frames.len()), (0, 0));
+}
+
+#[test]
+fn the_paused_frame_is_sent_once_at_output_size() {
+    let (mut h, log) = harness(true, true);
+    step_until(&mut h, &log, |l| !l.frames.is_empty());
+    for _ in 0..20 {
+        h.step();
+    }
+    let seq = h.state().session.active_sequence().map(|q| (q.settings.width as usize, q.settings.height as usize)).unwrap();
+    let l = log.lock().unwrap();
+    assert_eq!(l.opened, 1);
+    assert_eq!(l.frames.len(), 1, "a paused frame is sent once, not every refresh");
+    let (w, h) = (l.frames[0].0, l.frames[0].1);
+    assert!(w <= 1920 && h <= 1080 && (w == 1920.min(seq.0) || h == 1080.min(seq.1)), "{w}x{h} for a {}x{} sequence", seq.0, seq.1);
+}
+
+#[test]
+fn playing_sends_successive_frames_and_turning_off_closes() {
+    let (mut h, log) = harness(true, true);
+    step_until(&mut h, &log, |l| !l.frames.is_empty());
+    h.state_mut().play(1.0);
+    step_until(&mut h, &log, |l| l.frames.len() >= 6);
+    assert!(log.lock().unwrap().frames.len() >= 6, "frames follow playback");
+    h.state_mut().stop();
+    h.state_mut().session.prefs.playback.enable_transmit = false;
+    h.step();
+    let l = log.lock().unwrap();
+    assert_eq!((l.opened, l.closed), (1, 1), "turning the setting off releases the card");
+}
+
+#[test]
+fn without_a_card_the_output_is_tried_once_and_the_app_goes_on() {
+    let (mut h, log) = harness(true, false);
+    for _ in 0..30 {
+        h.step();
+    }
+    assert_eq!(log.lock().unwrap().opened, 1);
+    assert!(h.state().session.active_sequence().is_some());
+}
+
+/// Step until the output has sent `n` frames while playing, or ~30 s of real time pass (the
+/// suite runs many tests in parallel, so a fixed time window would measure the machine's load).
+fn play_until_sent(h: &mut Harness<'static, FilmcraftApp>, n: u64) -> (u64, u64) {
+    h.state_mut().play(1.0);
+    let t0 = std::time::Instant::now();
+    while h.state_mut().transmit_mut().counts().0 < n && t0.elapsed() < std::time::Duration::from_secs(30) {
+        h.step();
+        std::thread::sleep(std::time::Duration::from_millis(16));
+    }
+    h.state_mut().stop();
+    h.state_mut().transmit_mut().counts()
+}
+
+/// The CPU fallback (no GPU device, or the GPU path turned off) still sends paused and playing
+/// frames, each a later frame than the one before.
+#[test]
+fn the_cpu_fallback_sends_frames_too() {
+    let (mut h, log) = harness_gpu(true, true, false);
+    step_until(&mut h, &log, |l| !l.frames.is_empty());
+    assert_eq!(h.state_mut().transmit_mut().uses_gpu(), Some(false));
+    let (sent, skipped) = play_until_sent(&mut h, 8);
+    assert!(sent >= 8, "frames follow playback on the CPU path: {sent} sent, {skipped} skipped");
+}
+
+/// Where this machine has an off-screen GPU, playing goes through the GPU path: plans are
+/// composited off the UI thread and successive frames reach the output.
+#[test]
+fn playing_uses_the_gpu_path_where_there_is_a_gpu() {
+    let (mut h, log) = harness(true, true);
+    step_until(&mut h, &log, |l| !l.frames.is_empty());
+    if h.state_mut().transmit_mut().uses_gpu() != Some(true) {
+        eprintln!("no off-screen GPU device: skipped");
+        return;
+    }
+    let (sent, skipped) = play_until_sent(&mut h, 24);
+    assert!(sent >= 24, "{sent} sent, {skipped} skipped");
+    let l = log.lock().unwrap();
+    assert!(l.frames.iter().all(|f| f.0 <= 1920 && f.1 <= 1080), "output-sized frames");
+}
+
+/// Benchmark (run alone, on an idle machine: `cargo test --release -p filmcraft-ui-egui --test it
+/// transmit_ui::bench -- --ignored --nocapture`): 3 s of real playback of the demo project at
+/// 1080p on each path; the GPU path should send every frame (0 skipped).
+#[test]
+#[ignore = "timing benchmark: needs an idle machine"]
+fn bench_playback_throughput() {
+    for gpu in [false, true] {
+        let (mut h, log) = harness_gpu(true, true, gpu);
+        step_until(&mut h, &log, |l| !l.frames.is_empty());
+        let used = h.state_mut().transmit_mut().uses_gpu();
+        h.state_mut().play(1.0);
+        let t0 = std::time::Instant::now();
+        while t0.elapsed() < std::time::Duration::from_secs(3) {
+            h.step();
+            std::thread::sleep(std::time::Duration::from_millis(16));
+        }
+        h.state_mut().stop();
+        let (sent, skipped) = h.state_mut().transmit_mut().counts();
+        eprintln!("{} path: {sent} frames sent, {skipped} skipped in 3 s", if used == Some(true) { "GPU" } else { "CPU" });
+    }
+}
