diff --git a/crates/ui-egui/src/transmit.rs b/crates/ui-egui/src/transmit.rs
new file mode 100644
index 00000000..5af9e950
--- /dev/null
+++ b/crates/ui-egui/src/transmit.rs
@@ -0,0 +1,404 @@
+//! External Video Output (Settings ▸ Playback ▸ Enable External Video Output): the Program
+//! monitor's sequence frame on the host's [`VideoOutput`] (the desktop app's is a DeckLink card,
+//! `filmcraft_platform::decklink`, 1920 x 1080 25p).
+//!
+//! The card gets its own frame requests at the size that fits 1920 x 1080 (not the on-screen
+//! monitor's size), through the same [`FrameServer`](crate::frames::FrameServer) as the monitors.
+//!
+//! - **GPU path** (default where an off-screen GPU device opens): the frame workers decode and
+//!   plan the frames ([`Target::SequencePlan`] for that device's caps), and a thread of its own
+//!   ([`GpuStage`]) composites each plan on the off-screen device
+//!   ([`filmcraft_gpu::ExportRenderer::composite_rgba8`]), reads it back as sRGB RGBA8 and hands
+//!   it to the output, off the UI thread. About 5–10 ms a 1080p frame instead of ~60 ms on the CPU.
+//! - **CPU path** (fallback: no GPU, the device failed, or [`Transmit::set_gpu`] off): the CPU
+//!   compositor's sRGB frames ([`Target::Sequence`]).
+//!
+//! Paused, the frame at the playhead is requested and sent when ready; while playing, the next
+//! frames are scheduled like the monitor's and each frame is sent once, when it is ready (a frame
+//! not ready in time is skipped and the card holds the previous one). Opening the card happens
+//! when the setting is turned on; a missing card or driver is logged once and the output stays off
+//! until the setting is turned off and on again. While playing, a line with the frame counts and
+//! timings is logged every 5 s (`External Video Output: …`).
+
+use std::sync::{Arc, Condvar, Mutex, PoisonError};
+use std::time::{Duration, Instant};
+
+use filmcraft_project::Project;
+use filmcraft_render::plan::DeviceCaps;
+use filmcraft_time::FrameRate;
+
+use crate::frames::{FrameKey, GpuPlan, PLAYING_REVISION_LAG, Rgba, Target};
+use crate::hooks::{VideoOutput, VideoOutputOpener};
+
+/// The output frame size.
+pub const OUTPUT_SIZE: (u32, u32) = (1920, 1080);
+
+/// The open card, if any, and what it shows.
+pub struct Transmit {
+    output: Option<Arc<dyn VideoOutput>>,
+    /// Opening failed; not retried until the setting is turned off and on again.
+    failed: bool,
+    /// The frame last sent.
+    last: Option<FrameKey>,
+    /// Use the GPU path when it is available.
+    gpu_allowed: bool,
+    gpu: Option<GpuStage>,
+    meter: Meter,
+}
+
+impl Default for Transmit {
+    fn default() -> Self {
+        Self { output: None, failed: false, last: None, gpu_allowed: true, gpu: None, meter: Meter::default() }
+    }
+}
+
+impl Transmit {
+    /// Whether a card is open.
+    pub fn active(&self) -> bool {
+        self.output.is_some()
+    }
+
+    /// Allow the GPU path (on by default); off sends CPU-rendered frames. Takes effect the next
+    /// time the output opens.
+    pub fn set_gpu(&mut self, on: bool) {
+        self.gpu_allowed = on;
+    }
+
+    /// Whether frames go through the GPU path now (`None`: its device is still opening).
+    pub fn uses_gpu(&self) -> Option<bool> {
+        match &self.gpu {
+            None => Some(false),
+            Some(g) => g.caps().map(|c| c.is_some()),
+        }
+    }
+
+    /// Frames sent while playing since the output opened, and frames skipped (not ready in time).
+    pub fn counts(&self) -> (u64, u64) {
+        (self.meter.total_sent, self.meter.total_skipped)
+    }
+}
+
+/// Frames sent and skipped while playing, logged every few seconds.
+#[derive(Default)]
+struct Meter {
+    since: Option<Instant>,
+    sent: u64,
+    skipped: u64,
+    total_sent: u64,
+    total_skipped: u64,
+}
+
+impl Meter {
+    const EVERY: Duration = Duration::from_secs(5);
+
+    fn frame(&mut self, prev: Option<FrameKey>, k: FrameKey, playing: bool) {
+        if !playing {
+            self.since = None;
+            return;
+        }
+        let gap = prev.map(|p| (k.frame - p.frame).unsigned_abs().saturating_sub(1)).unwrap_or(0);
+        self.sent += 1;
+        self.skipped += gap;
+        self.total_sent += 1;
+        self.total_skipped += gap;
+    }
+
+    fn log(&mut self, path: &str, extra: Option<String>) {
+        let now = Instant::now();
+        let Some(since) = self.since else {
+            self.since = Some(now);
+            return;
+        };
+        if now - since < Self::EVERY {
+            return;
+        }
+        let secs = (now - since).as_secs_f64();
+        log::info!(
+            "External Video Output ({path}): {:.1} frames/s sent, {} skipped in {secs:.1} s{}",
+            self.sent as f64 / secs,
+            self.skipped,
+            extra.map(|e| format!("; {e}")).unwrap_or_default()
+        );
+        (self.since, self.sent, self.skipped) = (Some(now), 0, 0);
+    }
+}
+
+#[derive(Default)]
+struct GpuSlot {
+    latest: Option<Arc<GpuPlan>>,
+    quit: bool,
+    /// The off-screen device's caps once it opened; `Some(None)` when it could not.
+    caps: Option<Option<DeviceCaps>>,
+    composited: u64,
+    busy: Duration,
+}
+
+/// The GPU path's thread: composites the newest plan on an off-screen device and sends it.
+struct GpuStage {
+    shared: Arc<(Mutex<GpuSlot>, Condvar)>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+
+impl GpuStage {
+    fn start(output: Arc<dyn VideoOutput>) -> Option<Self> {
+        let shared: Arc<(Mutex<GpuSlot>, Condvar)> = Arc::default();
+        let worker = shared.clone();
+        let thread = std::thread::Builder::new().name("transmit-gpu".into()).spawn(move || gpu_thread(&worker, &*output)).ok()?;
+        Some(Self { shared, thread: Some(thread) })
+    }
+
+    fn slot(&self) -> std::sync::MutexGuard<'_, GpuSlot> {
+        self.shared.0.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    /// `None` while the device opens; then its caps, or `Some(None)` if it failed.
+    fn caps(&self) -> Option<Option<DeviceCaps>> {
+        self.slot().caps
+    }
+
+    fn send(&self, plan: Arc<GpuPlan>) {
+        self.slot().latest = Some(plan);
+        self.shared.1.notify_one();
+    }
+
+    fn timing(&self) -> String {
+        let s = self.slot();
+        format!("GPU composite + read-back {:.1} ms/frame", s.busy.as_secs_f64() * 1000.0 / s.composited.max(1) as f64)
+    }
+}
+
+impl Drop for GpuStage {
+    fn drop(&mut self) {
+        self.slot().quit = true;
+        self.shared.1.notify_one();
+        if let Some(t) = self.thread.take() {
+            let _ = t.join();
+        }
+    }
+}
+
+fn gpu_thread(shared: &(Mutex<GpuSlot>, Condvar), output: &dyn VideoOutput) {
+    let lock = || shared.0.lock().unwrap_or_else(PoisonError::into_inner);
+    let mut renderer = filmcraft_gpu::ExportRenderer::new();
+    lock().caps = Some(renderer.as_ref().map(filmcraft_gpu::ExportRenderer::caps));
+    let Some(r) = renderer.as_mut() else {
+        log::info!("External Video Output: no off-screen GPU device, rendering on the CPU");
+        return;
+    };
+    loop {
+        let plan = {
+            let mut slot = lock();
+            loop {
+                if slot.quit {
+                    return;
+                }
+                if let Some(p) = slot.latest.take() {
+                    break p;
+                }
+                slot = shared.1.wait(slot).unwrap_or_else(PoisonError::into_inner);
+            }
+        };
+        let t0 = Instant::now();
+        let Some((w, h, px)) = r.composite_rgba8(&plan.plan, &plan.prepared) else {
+            log::warn!("External Video Output: the GPU device failed, rendering on the CPU");
+            lock().caps = Some(None);
+            return;
+        };
+        {
+            let mut slot = lock();
+            slot.composited += 1;
+            slot.busy += t0.elapsed();
+        }
+        output.send(Arc::new(Rgba { w: w as usize, h: h as usize, px }));
+    }
+}
+
+/// The render scale that fits a `w` x `h` sequence inside 1920 x 1080 (never above 1).
+pub fn output_scale(w: u32, h: u32) -> f32 {
+    let (w, h) = (w.max(1) as f32, h.max(1) as f32);
+    (OUTPUT_SIZE.0 as f32 / w).min(OUTPUT_SIZE.1 as f32 / h).min(1.0)
+}
+
+/// What the Program monitor shows this refresh.
+pub struct ProgramFrame<'a> {
+    /// The monitor's CPU target: only a sequence ([`Target::Sequence`]) is sent.
+    pub target: Target,
+    pub frame: i64,
+    pub frame_size: (u32, u32),
+    pub rate: FrameRate,
+    pub revision: u64,
+    pub playing: bool,
+    pub speed: f64,
+    pub project: &'a Arc<Project>,
+}
+
+/// Open or close the output as the setting says (`on`). Returns whether it is open.
+fn ensure_open(t: &mut Transmit, on: bool, opener: Option<&mut VideoOutputOpener>) -> bool {
+    if !on {
+        // the GPU thread holds the output too: stop it first, so dropping ours releases the card
+        t.gpu = None;
+        if t.output.take().is_some() {
+            log::info!("External Video Output: closed the DeckLink output");
+        }
+        t.failed = false;
+        t.last = None;
+        return false;
+    }
+    if t.output.is_none() && !t.failed {
+        let opened = match opener {
+            Some(open) => open(),
+            None => Err("this build has no external video output".to_string()),
+        };
+        match opened {
+            Ok(o) => {
+                log::info!("External Video Output: {} at 1080p25", o.name());
+                let o: Arc<dyn VideoOutput> = Arc::from(o);
+                t.gpu = if t.gpu_allowed { GpuStage::start(o.clone()) } else { None };
+                t.output = Some(o);
+                t.meter = Meter::default();
+            }
+            Err(e) => {
+                log::warn!("External Video Output is on but unavailable: {e}");
+                t.failed = true;
+            }
+        }
+    }
+    t.output.is_some()
+}
+
+/// Called by the monitors every refresh (`program`: this is the Program monitor): request the
+/// output's frame and send it to the card once it is ready.
+pub fn update(app: &mut crate::FilmcraftApp, program: bool, p: ProgramFrame<'_>) {
+    let Target::Sequence(seq) = p.target else { return };
+    if !program {
+        return;
+    }
+    let on = app.session.prefs.playback.enable_transmit;
+    if !ensure_open(&mut app.transmit, on, app.hooks.open_video_output.as_mut()) {
+        return;
+    }
+    // while prerolling the clock has not started: the frame at the playhead, like paused
+    let playing = p.playing && app.playback.preroll.is_none();
+    let scale = crate::panels::monitor::quantize_scale(output_scale(p.frame_size.0, p.frame_size.1));
+    let size = (scale * 1000.0) as u32;
+    // the GPU path while its device is open (or still opening: nothing is sent meanwhile)
+    let gpu = app.transmit.gpu.as_ref().map(GpuStage::caps);
+    let target = match gpu {
+        Some(Some(Some(caps))) => Target::SequencePlan(seq, caps),
+        Some(None) => return,
+        _ => Target::Sequence(seq),
+    };
+    let key = FrameKey { target, frame: p.frame, size, revision: p.revision, draft: false };
+    if playing {
+        app.frames.schedule_playback(key, p.rate, scale, p.project, p.speed, false);
+    } else {
+        app.frames.request(key, p.rate.tick_of(p.frame), scale, p.project, 0);
+    }
+    let dir = if p.speed < 0.0 { -1 } else { 1 };
+    let ready = |k: &FrameKey| app.frames.is_ready(k);
+    let shown = if ready(&key) {
+        Some(key)
+    } else if playing {
+        app.frames.recent(key, dir, 6, PLAYING_REVISION_LAG)
+    } else {
+        None
+    };
+    let Some(k) = shown.filter(|k| app.transmit.last != Some(*k)) else {
+        log_playing(&mut app.transmit, playing);
+        return;
+    };
+    let sent = match (&app.transmit.gpu, &app.transmit.output) {
+        (Some(g), _) if matches!(k.target, Target::SequencePlan(..)) => app.frames.get_plan(&k).map(|plan| g.send(plan)).is_some(),
+        (_, Some(out)) => app.frames.get(&k).map(|frame| out.send(frame)).is_some(),
+        _ => false,
+    };
+    if sent {
+        let t = &mut app.transmit;
+        t.meter.frame(t.last, k, playing);
+        t.last = Some(k);
+    }
+    log_playing(&mut app.transmit, playing);
+}
+
+fn log_playing(t: &mut Transmit, playing: bool) {
+    if !playing {
+        t.meter.since = None;
+        return;
+    }
+    let (path, extra) = match &t.gpu {
+        Some(g) if matches!(g.caps(), Some(Some(_))) => ("GPU", Some(g.timing())),
+        _ => ("CPU", None),
+    };
+    let extra = [extra, t.output.as_ref().and_then(|o| o.stats())].into_iter().flatten().collect::<Vec<_>>();
+    t.meter.log(path, (!extra.is_empty()).then(|| extra.join("; ")));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn output_scale_fits_1080() {
+        assert_eq!(output_scale(1920, 1080), 1.0);
+        assert_eq!(output_scale(3840, 2160), 0.5);
+        assert_eq!(output_scale(1280, 720), 1.0, "smaller sequences are not rendered larger");
+        assert_eq!(output_scale(1080, 1920), 0.5625);
+        assert!(output_scale(0, 0) <= 1.0);
+    }
+
+    #[test]
+    fn turning_the_setting_off_closes_and_clears_a_failure() {
+        let mut t = Transmit {
+            output: None,
+            failed: true,
+            last: Some(FrameKey { target: Target::Item(filmcraft_project::ItemId(1)), frame: 0, size: 1000, revision: 0, draft: false }),
+            ..Transmit::default()
+        };
+        assert!(!ensure_open(&mut t, false, None));
+        assert!(!t.failed && t.last.is_none() && !t.active());
+    }
+
+    struct Fake(Arc<std::sync::atomic::AtomicUsize>);
+
+    impl VideoOutput for Fake {
+        fn name(&self) -> String {
+            "fake".into()
+        }
+        fn send(&self, _frame: Arc<crate::frames::Rgba>) {
+            self.0.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+
+    #[test]
+    fn a_failed_open_is_tried_once_until_the_setting_is_toggled() {
+        let tries = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let counted = tries.clone();
+        let mut opener: VideoOutputOpener = Box::new(move || {
+            counted.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            Err("no card".into())
+        });
+        let mut t = Transmit::default();
+        assert!(!ensure_open(&mut t, true, Some(&mut opener)));
+        assert!(!ensure_open(&mut t, true, Some(&mut opener)));
+        assert_eq!(tries.load(std::sync::atomic::Ordering::Relaxed), 1, "logged and tried once");
+        ensure_open(&mut t, false, Some(&mut opener));
+        assert!(!ensure_open(&mut t, true, Some(&mut opener)));
+        assert_eq!(tries.load(std::sync::atomic::Ordering::Relaxed), 2, "turning it on again retries");
+        // no host output at all: off, quietly
+        let mut none = Transmit::default();
+        assert!(!ensure_open(&mut none, true, None));
+    }
+
+    #[test]
+    fn an_open_output_stays_open_until_turned_off() {
+        let sent = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let s2 = sent.clone();
+        let mut opener: VideoOutputOpener = Box::new(move || Ok(Box::new(Fake(s2.clone())) as Box<dyn VideoOutput>));
+        let mut t = Transmit::default();
+        t.set_gpu(false);
+        assert!(ensure_open(&mut t, true, Some(&mut opener)) && t.active());
+        assert_eq!(t.uses_gpu(), Some(false));
+        assert!(ensure_open(&mut t, true, Some(&mut opener)));
+        assert!(!ensure_open(&mut t, false, Some(&mut opener)) && !t.active());
+    }
+}
