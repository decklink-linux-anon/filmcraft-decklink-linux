+//! External Video Output for the desktop app: [`filmcraft_ui_egui::VideoOutput`] over a DeckLink
+//! card ([`filmcraft_platform::decklink`]).
+
+use std::sync::Arc;
+
+use filmcraft_platform::decklink;
+use filmcraft_ui_egui::VideoOutput;
+use filmcraft_ui_egui::frames::Rgba;
+
+/// A monitor frame handed to the output thread without copying.
+struct Picture(Arc<Rgba>);
+
+impl decklink::RgbaPicture for Picture {
+    fn size(&self) -> (usize, usize) {
+        (self.0.w, self.0.h)
+    }
+    fn rgba(&self) -> &[u8] {
+        &self.0.px
+    }
+}
+
+struct DeckLink(decklink::Output);
+
+impl VideoOutput for DeckLink {
+    fn name(&self) -> String {
+        self.0.name().to_string()
+    }
+    fn stats(&self) -> Option<String> {
+        let s = self.0.stats();
+        let per = |d: std::time::Duration| d.as_secs_f64() * 1000.0 / s.shown.max(1) as f64;
+        Some(format!("card: {} shown, {} refused, UYVY {:.1} ms, push {:.1} ms per frame", s.shown, s.failed, per(s.convert), per(s.display)))
+    }
+    fn send(&self, frame: Arc<Rgba>) {
+        self.0.send(Arc::new(Picture(frame)));
+    }
+}
+
+/// Open DeckLink device 0 at 1080p25.
+pub fn open() -> Result<Box<dyn VideoOutput>, String> {
+    decklink::Output::open().map(|o| Box::new(DeckLink(o)) as Box<dyn VideoOutput>).map_err(|e| e.to_string())
+}
