+use super::*;
+
+fn uyvy_of(rgb: [u8; 3]) -> [u8; 4] {
+    let src = [rgb[0], rgb[1], rgb[2], 255, rgb[0], rgb[1], rgb[2], 255];
+    let mut dst = [0u8; 4];
+    rgba_to_uyvy(&src, 2, 1, &mut dst, 2, 1);
+    dst
+}
+
+#[test]
+fn black_and_white_are_limited_range() {
+    assert_eq!(uyvy_of([0, 0, 0]), [128, 16, 128, 16]);
+    assert_eq!(uyvy_of([255, 255, 255]), [128, 235, 128, 235]);
+}
+
+#[test]
+fn primaries_follow_bt709() {
+    // BT.709 limited range: red Y' 63, Cb 102, Cr 240; green 173 / 42 / 26; blue 32 / 240 / 118
+    assert_eq!(uyvy_of([255, 0, 0]), [102, 63, 240, 63]);
+    assert_eq!(uyvy_of([0, 255, 0]), [42, 173, 26, 173]);
+    assert_eq!(uyvy_of([0, 0, 255]), [240, 32, 118, 32]);
+}
+
+#[test]
+fn a_pair_shares_averaged_chroma() {
+    let src = [255, 255, 255, 255, 0, 0, 0, 255];
+    let mut dst = [0u8; 4];
+    rgba_to_uyvy(&src, 2, 1, &mut dst, 2, 1);
+    assert_eq!(dst, [128, 235, 128, 16]);
+}
+
+#[test]
+fn narrower_pictures_are_pillarboxed() {
+    // a 2 x 2 white square in a 4 x 2 frame: black, white, white, black
+    let src = vec![255u8; 2 * 2 * 4];
+    let mut dst = vec![0u8; 4 * 2 * 2];
+    rgba_to_uyvy(&src, 2, 2, &mut dst, 4, 2);
+    for row in dst.chunks(8) {
+        assert_eq!(row[1], 16, "left bar");
+        assert_eq!(row[3], 235);
+        assert_eq!(row[5], 235);
+        assert_eq!(row[7], 16, "right bar");
+    }
+}
+
+#[test]
+fn fit_keeps_the_aspect() {
+    assert_eq!(fit(1920, 1080, 1920, 1080), (0, 0, 1920, 1080));
+    assert_eq!(fit(3840, 2160, 1920, 1080), (0, 0, 1920, 1080));
+    assert_eq!(fit(1080, 1920, 1920, 1080), (656, 0, 608, 1080));
+    assert_eq!(fit(1920, 800, 1920, 1080), (0, 140, 1920, 800));
+    assert_eq!(fit(0, 10, 1920, 1080), (0, 0, 0, 0));
+}
+
+#[test]
+fn hostile_input_gives_black_without_panicking() {
+    let mut dst = vec![7u8; ROW_BYTES * 2];
+    rgba_to_uyvy(&[1, 2, 3], 1000, 1000, &mut dst, WIDTH, 2);
+    assert!(dst.chunks(2).all(|p| p == [128, 16]));
+    rgba_to_uyvy(&[], 0, 0, &mut dst, WIDTH, 2);
+    let mut odd = vec![0u8; 6];
+    rgba_to_uyvy(&[255; 16], 2, 2, &mut odd, 3, 1);
+}
+
+#[test]
+fn a_full_frame_converts() {
+    let bars = color_bars(WIDTH, HEIGHT);
+    let mut dst = vec![0u8; ROW_BYTES * HEIGHT];
+    rgba_to_uyvy(&bars.pixels, WIDTH, HEIGHT, &mut dst, WIDTH, HEIGHT);
+    // the first bar is 75 % white: Y' = 16 + 219 * 0.749 = 180
+    assert_eq!(&dst[..4], &[128, 180, 128, 180]);
+}
+
+#[test]
+fn opening_without_a_card_is_an_error_not_a_crash() {
+    // On a machine with a card this opens it (and dropping closes it); either way nothing panics.
+    if let Err(e) = Output::open() {
+        assert!(!e.to_string().is_empty());
+    }
+}
