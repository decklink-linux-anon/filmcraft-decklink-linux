index 00000000..9324c6fa
--- /dev/null
+++ b/crates/platform/src/decklink/ffi.rs
@@ -0,0 +1,61 @@
+//! The C ABI of `decklink/shim.cpp`. The handle is created, used and released on the output
+//! thread only.
+
+use super::{HEIGHT, OpenError, ROW_BYTES, WIDTH};
+use std::ffi::{c_char, c_int, c_void};
+
+unsafe extern "C" {
+    fn fc_dl_open(out: *mut *mut c_void, name: *mut c_char, name_len: c_int) -> c_int;
+    fn fc_dl_display_uyvy(handle: *mut c_void, data: *const u8, len: usize, width: c_int, height: c_int, row_bytes: c_int) -> c_int;
+    fn fc_dl_close(handle: *mut c_void);
+}
+
+/// An open DeckLink output (device 0, 1080p25 UYVY). Not `Send`: it stays on the thread that
+/// opened it.
+pub(super) struct Device {
+    handle: *mut c_void,
+    pub(super) name: String,
+}
+
+impl Device {
+    pub(super) fn open() -> Result<Self, OpenError> {
+        let mut handle: *mut c_void = std::ptr::null_mut();
+        let mut name = [0 as c_char; 256];
+        // SAFETY: `handle` is a valid out-pointer and `name` a writable buffer of the length
+        // passed; the shim NUL-terminates what it writes and catches every C++ exception.
+        let code = unsafe { fc_dl_open(&mut handle, name.as_mut_ptr(), name.len() as c_int) };
+        if code != 0 || handle.is_null() {
+            return Err(match code {
+                -1 => OpenError::NoLibrary,
+                -2 => OpenError::NoDevice,
+                -3 => OpenError::NoOutput,
+                -4 => OpenError::ModeUnsupported,
+                -5 => OpenError::EnableFailed,
+                c => OpenError::Driver(c),
+            });
+        }
+        // SAFETY: the buffer is zero-initialised and the shim writes at most len - 1 bytes plus
+        // a NUL, so it holds a NUL-terminated string within its bounds.
+        let name = unsafe { std::ffi::CStr::from_ptr(name.as_ptr()) }.to_string_lossy().into_owned();
+        Ok(Self { handle, name })
+    }
+
+    /// Show one 1920 x 1080 UYVY picture (`ROW_BYTES * HEIGHT` bytes).
+    pub(super) fn display(&self, uyvy: &[u8]) -> Result<(), i32> {
+        if uyvy.len() < ROW_BYTES * HEIGHT {
+            return Err(-7);
+        }
+        // SAFETY: `handle` came from a successful `fc_dl_open` and is not closed until drop; the
+        // pointer and length describe a live slice the shim only reads (it checks the length
+        // against the frame size).
+        let code = unsafe { fc_dl_display_uyvy(self.handle, uyvy.as_ptr(), uyvy.len(), WIDTH as c_int, HEIGHT as c_int, ROW_BYTES as c_int) };
+        if code == 0 { Ok(()) } else { Err(code) }
+    }
+}
+
+impl Drop for Device {
+    fn drop(&mut self) {
+        // SAFETY: `handle` came from `fc_dl_open` and is released exactly once, here.
+        unsafe { fc_dl_close(self.handle) }
+    }
+}
