--- /dev/null
+++ b/crates/platform/build.rs
@@ -0,0 +1,22 @@
+//! Linux: compile the DeckLink output shim (`decklink/shim.cpp`) and Blackmagic's dispatch file,
+//! which loads `libDeckLinkAPI.so` at run time with `dlopen` (nothing is linked at build time, so a
+//! system without Blackmagic Desktop Video builds and runs; it just has no DeckLink output).
+
+fn main() {
+    println!("cargo:rerun-if-changed=decklink");
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("linux") {
+        return;
+    }
+    cc::Build::new()
+        .cpp(true)
+        .file("decklink/shim.cpp")
+        .file("decklink/sdk/DeckLinkAPIDispatch.cpp")
+        .include("decklink")
+        .flag_if_supported("-std=c++17")
+        .flag_if_supported("-fno-strict-aliasing")
+        // Blackmagic's headers trip -Wall in places; they are kept unmodified.
+        .warnings(false)
+        .compile("filmcraft_decklink");
+    println!("cargo:rustc-link-lib=dl");
+    println!("cargo:rustc-link-lib=pthread");
+}
