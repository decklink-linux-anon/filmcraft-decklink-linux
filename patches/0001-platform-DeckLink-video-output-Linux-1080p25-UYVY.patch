+# Blackmagic DeckLink SDK (Linux include files, API 12.0)
+
+Unmodified copies of the Linux `include/` files of the Blackmagic Design DeckLink SDK 12.0, as
+redistributed in the OBS Studio repository (`plugins/decklink/linux/decklink-sdk`). Only the
+files the output shim (`../shim.cpp`) needs are kept.
+
+- source: Blackmagic Design DeckLink SDK 12.0 (`Linux/include`)
+- license: BSL-1.0 (the Boost Software License text, with Blackmagic Design's copyright; it is
+  reproduced at the top of every file, which is what the licence requires)
+- copyright: Copyright (c) 2021 Blackmagic Design
+
+`DeckLinkAPIDispatch.cpp` loads `libDeckLinkAPI.so` (installed by Blackmagic Desktop Video) with
+`dlopen` at run time, so building needs no Blackmagic software and a system without it simply
+has no DeckLink output. Newer drivers (tested: Desktop Video 16.5) still answer the 12.0
+interfaces.
diff --git a/crates/platform/decklink/shim.cpp b/crates/platform/decklink/shim.cpp
new file mode 100644
index 00000000..4769e4b4
--- /dev/null
+++ b/crates/platform/decklink/shim.cpp
@@ -0,0 +1,151 @@
+// FilmCraft DeckLink output shim (Linux): a tiny C API over the DeckLink COM-style interfaces, so
+// the Rust side (`src/decklink.rs`) never touches C++ vtables. Every function catches everything:
+// no C++ exception crosses into Rust.
+//
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <new>
+#include "sdk/DeckLinkAPI.h"
+
+namespace {
+
+struct Output {
+    IDeckLink* device = nullptr;
+    IDeckLinkOutput* output = nullptr;
+    IDeckLinkMutableVideoFrame* frames[2] = {nullptr, nullptr};
+    int next = 0;
+    int width = 0;
+    int height = 0;
+    int row_bytes = 0;
+};
+
+void release(Output* o) {
+    if (!o) return;
+    if (o->output) o->output->DisableVideoOutput();
+    for (auto*& f : o->frames) {
+        if (f) f->Release();
+        f = nullptr;
+    }
+    if (o->output) o->output->Release();
+    if (o->device) o->device->Release();
+    delete o;
+}
+
+}  // namespace
+
+extern "C" {
+
+// Error codes (keep in step with `decklink::OpenError` in src/decklink.rs).
+enum {
+    FC_DL_OK = 0,
+    FC_DL_NO_LIBRARY = -1,   // libDeckLinkAPI.so missing (Desktop Video not installed)
+    FC_DL_NO_DEVICE = -2,    // no DeckLink device
+    FC_DL_NO_OUTPUT = -3,    // device 0 has no output interface
+    FC_DL_UNSUPPORTED = -4,  // 1080p25 8-bit YUV not supported
+    FC_DL_ENABLE_FAILED = -5,  // EnableVideoOutput failed (device busy in another program?)
+    FC_DL_FRAME_FAILED = -6,   // CreateVideoFrame failed
+    FC_DL_BAD_ARGS = -7,
+    FC_DL_DISPLAY_FAILED = -8,
+    FC_DL_INTERNAL = -9,
+};
+
+// Open DeckLink device 0 for 1920x1080 25p 8-bit Y'CbCr 4:2:2 (UYVY) output. On success `*out`
+// holds the handle and the device's display name is copied (NUL-terminated) into `name`.
+int fc_dl_open(void** out, char* name, int name_len) noexcept {
+    if (!out) return FC_DL_BAD_ARGS;
+    *out = nullptr;
+    try {
+        IDeckLinkIterator* it = CreateDeckLinkIteratorInstance();
+        if (!it) return FC_DL_NO_LIBRARY;
+        IDeckLink* dl = nullptr;
+        HRESULT r = it->Next(&dl);
+        it->Release();
+        if (r != S_OK || !dl) return FC_DL_NO_DEVICE;
+        Output* o = new (std::nothrow) Output();
+        if (!o) {
+            dl->Release();
+            return FC_DL_INTERNAL;
+        }
+        o->device = dl;
+        if (name && name_len > 0) {
+            name[0] = 0;
+            const char* n = nullptr;
+            if (dl->GetDisplayName(&n) == S_OK && n) {
+                strncpy(name, n, (size_t)name_len - 1);
+                name[name_len - 1] = 0;
+                free((void*)n);
+            }
+        }
+        if (dl->QueryInterface(IID_IDeckLinkOutput, (void**)&o->output) != S_OK || !o->output) {
+            o->output = nullptr;
+            release(o);
+            return FC_DL_NO_OUTPUT;
+        }
+        bool supported = false;
+        BMDDisplayMode actual = bmdModeUnknown;
+        if (o->output->DoesSupportVideoMode(bmdVideoConnectionUnspecified, bmdModeHD1080p25, bmdFormat8BitYUV, bmdNoVideoOutputConversion,
+                                            bmdSupportedVideoModeDefault, &actual, &supported) != S_OK ||
+            !supported) {
+            release(o);
+            return FC_DL_UNSUPPORTED;
+        }
+        if (o->output->EnableVideoOutput(bmdModeHD1080p25, bmdVideoOutputFlagDefault) != S_OK) {
+            // nothing to disable: forget the interface's enabled state before release() calls it
+            o->output->Release();
+            o->output = nullptr;
+            release(o);
+            return FC_DL_ENABLE_FAILED;
+        }
+        o->width = 1920;
+        o->height = 1080;
+        o->row_bytes = 1920 * 2;
+        for (auto*& f : o->frames) {
+            if (o->output->CreateVideoFrame(o->width, o->height, o->row_bytes, bmdFormat8BitYUV, bmdFrameFlagDefault, &f) != S_OK || !f) {
+                f = nullptr;
+                release(o);
+                return FC_DL_FRAME_FAILED;
+            }
+        }
+        *out = o;
+        return FC_DL_OK;
+    } catch (...) {
+        return FC_DL_INTERNAL;
+    }
+}
+
+// Show one UYVY picture (`len` bytes, `width` x `height`, rows of `row_bytes`) at the next frame
+// boundary. The pixels are copied into one of two device frames, alternately, so the frame being
+// scanned out is never written.
+int fc_dl_display_uyvy(void* handle, const uint8_t* data, size_t len, int width, int height, int row_bytes) noexcept {
+    Output* o = static_cast<Output*>(handle);
+    if (!o || !data || width != o->width || height != o->height || row_bytes != o->row_bytes ||
+        len < (size_t)row_bytes * (size_t)height)
+        return FC_DL_BAD_ARGS;
+    try {
+        IDeckLinkMutableVideoFrame* f = o->frames[o->next];
+        o->next ^= 1;
+        void* bytes = nullptr;
+        if (f->GetBytes(&bytes) != S_OK || !bytes) return FC_DL_DISPLAY_FAILED;
+        long dst_row = f->GetRowBytes();
+        if (dst_row < row_bytes) return FC_DL_DISPLAY_FAILED;
+        for (int y = 0; y < height; y++) {
+            memcpy(static_cast<uint8_t*>(bytes) + (size_t)y * (size_t)dst_row, data + (size_t)y * (size_t)row_bytes, (size_t)row_bytes);
+        }
+        return o->output->DisplayVideoFrameSync(f) == S_OK ? FC_DL_OK : FC_DL_DISPLAY_FAILED;
+    } catch (...) {
+        return FC_DL_INTERNAL;
+    }
+}
+
+// Stop output and release the device. `handle` may be null.
+void fc_dl_close(void* handle) noexcept {
+    try {
+        release(static_cast<Output*>(handle));
+    } catch (...) {
+    }
+}
+
+}  // extern "C"
