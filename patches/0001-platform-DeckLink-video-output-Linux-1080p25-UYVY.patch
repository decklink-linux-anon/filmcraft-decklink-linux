index 00000000..0dc1e714
--- /dev/null
+++ b/crates/platform/src/decklink.rs
@@ -0,0 +1,361 @@
+//! External video output on a Blackmagic DeckLink card (Settings ▸ Playback ▸ Enable External
+//! Video Output): the Program picture as 1920 x 1080 25p, 8-bit Y'CbCr 4:2:2 (UYVY), BT.709
+//! limited range, on DeckLink device 0.
+//!
+//! [`Output::open`] starts a thread that owns the device. [`Output::send`] hands it the newest
+//! picture (sRGB / BT.709 R'G'B'A, 8 bits); a picture not yet shown is replaced by a newer one, so
+//! a slow card or conversion never queues frames up. The thread converts it ([`rgba_to_uyvy`]:
+//! fitted inside 1920 x 1080, letterboxed or pillarboxed in black) and shows it at the card's next
+//! frame boundary (`DisplayVideoFrameSync`). No audio.
+//!
+//! Linux only for now: the C++ shim (`decklink/shim.cpp`, built by `build.rs`) loads
+//! `libDeckLinkAPI.so` from Blackmagic Desktop Video at run time. Elsewhere, and on Linux without
+//! the library or a card, [`Output::open`] returns an [`OpenError`].
+
+use std::sync::{Arc, Condvar, Mutex, PoisonError};
+
+#[cfg(target_os = "linux")]
+#[allow(unsafe_code)]
+mod ffi;
+
+/// Output frame width (pixels).
+pub const WIDTH: usize = 1920;
+/// Output frame height (lines).
+pub const HEIGHT: usize = 1080;
+/// Bytes per UYVY line.
+pub const ROW_BYTES: usize = WIDTH * 2;
+
+/// A picture to show: 8-bit R'G'B'A (sRGB / BT.709 encoded, alpha ignored), rows packed.
+pub trait RgbaPicture: Send + Sync {
+    /// Width and height in pixels.
+    fn size(&self) -> (usize, usize);
+    /// `width * height * 4` bytes.
+    fn rgba(&self) -> &[u8];
+}
+
+/// A plain owned picture (tests, the CLI's test frame).
+pub struct OwnedRgba {
+    pub width: usize,
+    pub height: usize,
+    pub pixels: Vec<u8>,
+}
+
+impl RgbaPicture for OwnedRgba {
+    fn size(&self) -> (usize, usize) {
+        (self.width, self.height)
+    }
+    fn rgba(&self) -> &[u8] {
+        &self.pixels
+    }
+}
+
+/// Why the output could not be opened.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum OpenError {
+    /// Not implemented on this operating system.
+    Unsupported,
+    /// `libDeckLinkAPI.so` is missing (Blackmagic Desktop Video not installed).
+    NoLibrary,
+    /// No DeckLink device.
+    NoDevice,
+    /// Device 0 has no video output.
+    NoOutput,
+    /// Device 0 cannot output 1080p25 8-bit Y'CbCr.
+    ModeUnsupported,
+    /// The device refused to start output (in use by another program?).
+    EnableFailed,
+    /// Any other driver failure (code from the shim).
+    Driver(i32),
+}
+
+impl std::fmt::Display for OpenError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Unsupported => write!(f, "DeckLink output is only available on Linux"),
+            Self::NoLibrary => write!(f, "Blackmagic Desktop Video (libDeckLinkAPI.so) is not installed"),
+            Self::NoDevice => write!(f, "no DeckLink device found"),
+            Self::NoOutput => write!(f, "the DeckLink device has no video output"),
+            Self::ModeUnsupported => write!(f, "the DeckLink device cannot output 1080p25 8-bit YUV"),
+            Self::EnableFailed => write!(f, "the DeckLink device refused to start output (is another program using it?)"),
+            Self::Driver(c) => write!(f, "DeckLink driver error {c}"),
+        }
+    }
+}
+
+impl std::error::Error for OpenError {}
+
+#[derive(Default)]
+struct Slot {
+    latest: Option<Arc<dyn RgbaPicture>>,
+    quit: bool,
+    /// Pictures the card accepted.
+    shown: u64,
+    /// Pictures the card refused.
+    failed: u64,
+    /// Time spent converting to UYVY and handing pictures to the card.
+    convert: std::time::Duration,
+    display: std::time::Duration,
+}
+
+/// What the output thread has done so far ([`Output::stats`]).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Stats {
+    /// Pictures the card accepted.
+    pub shown: u64,
+    /// Pictures the card refused.
+    pub failed: u64,
+    /// Total time converting R'G'B'A to UYVY.
+    pub convert: std::time::Duration,
+    /// Total time handing pictures to the card.
+    pub display: std::time::Duration,
+}
+
+type Shared = Arc<(Mutex<Slot>, Condvar)>;
+
+/// An open DeckLink output. Dropping it stops the output and releases the card.
+pub struct Output {
+    shared: Shared,
+    thread: Option<std::thread::JoinHandle<()>>,
+    name: String,
+}
+
+impl Output {
+    /// Open DeckLink device 0 for 1080p25 output and start its thread.
+    pub fn open() -> Result<Self, OpenError> {
+        let shared: Shared = Arc::new((Mutex::new(Slot::default()), Condvar::new()));
+        let (tx, rx) = std::sync::mpsc::sync_channel::<Result<String, OpenError>>(1);
+        let worker = shared.clone();
+        let thread = std::thread::Builder::new().name("decklink-output".into()).spawn(move || run(&worker, &tx)).map_err(|_| OpenError::Driver(-100))?;
+        match rx.recv() {
+            Ok(Ok(name)) => Ok(Self { shared, thread: Some(thread), name }),
+            Ok(Err(e)) => {
+                let _ = thread.join();
+                Err(e)
+            }
+            Err(_) => {
+                let _ = thread.join();
+                Err(OpenError::Driver(-101))
+            }
+        }
+    }
+
+    /// The device's display name ("DeckLink Mini Monitor HD").
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// Pictures the card has accepted and refused so far.
+    pub fn counts(&self) -> (u64, u64) {
+        let s = self.stats();
+        (s.shown, s.failed)
+    }
+
+    /// Counts and timings of the output thread.
+    pub fn stats(&self) -> Stats {
+        let slot = self.shared.0.lock().unwrap_or_else(PoisonError::into_inner);
+        Stats { shown: slot.shown, failed: slot.failed, convert: slot.convert, display: slot.display }
+    }
+
+    /// Show `picture` as soon as possible, replacing any picture not shown yet.
+    pub fn send(&self, picture: Arc<dyn RgbaPicture>) {
+        let (m, cv) = &*self.shared;
+        m.lock().unwrap_or_else(PoisonError::into_inner).latest = Some(picture);
+        cv.notify_one();
+    }
+}
+
+impl Drop for Output {
+    fn drop(&mut self) {
+        let (m, cv) = &*self.shared;
+        m.lock().unwrap_or_else(PoisonError::into_inner).quit = true;
+        cv.notify_one();
+        if let Some(t) = self.thread.take() {
+            let _ = t.join();
+        }
+    }
+}
+
+/// The output thread: open the device (reporting the result on `ready`), then show pictures until
+/// told to quit.
+fn run(shared: &Shared, ready: &std::sync::mpsc::SyncSender<Result<String, OpenError>>) {
+    let device = match Device::open() {
+        Ok(d) => d,
+        Err(e) => {
+            let _ = ready.send(Err(e));
+            return;
+        }
+    };
+    if ready.send(Ok(device.name.clone())).is_err() {
+        return;
+    }
+    let mut uyvy = vec![0u8; ROW_BYTES * HEIGHT];
+    let mut warned = false;
+    while let Some(picture) = next_picture(shared) {
+        let (w, h) = picture.size();
+        let t0 = std::time::Instant::now();
+        rgba_to_uyvy(picture.rgba(), w, h, &mut uyvy, WIDTH, HEIGHT);
+        let t1 = std::time::Instant::now();
+        let shown = device.display(&uyvy);
+        count(shared, shown.is_ok(), t1 - t0, t1.elapsed());
+        if let Err(code) = shown
+            && !warned
+        {
+            log::warn!("DeckLink: showing a frame failed (code {code}); further failures are not logged");
+            warned = true;
+        }
+    }
+}
+
+fn count(shared: &Shared, ok: bool, convert: std::time::Duration, display: std::time::Duration) {
+    let mut slot = shared.0.lock().unwrap_or_else(PoisonError::into_inner);
+    slot.convert += convert;
+    slot.display += display;
+    if ok {
+        slot.shown += 1;
+    } else {
+        slot.failed += 1;
+    }
+}
+
+/// Wait for the next picture; `None` when the output is being closed.
+fn next_picture(shared: &Shared) -> Option<Arc<dyn RgbaPicture>> {
+    let (m, cv) = &**shared;
+    let mut slot = m.lock().unwrap_or_else(PoisonError::into_inner);
+    loop {
+        if slot.quit {
+            return None;
+        }
+        if let Some(p) = slot.latest.take() {
+            return Some(p);
+        }
+        slot = cv.wait(slot).unwrap_or_else(PoisonError::into_inner);
+    }
+}
+
+#[cfg(target_os = "linux")]
+use ffi::Device;
+
+/// Stand-in where there is no DeckLink support.
+#[cfg(not(target_os = "linux"))]
+struct Device {
+    name: String,
+}
+
+#[cfg(not(target_os = "linux"))]
+impl Device {
+    fn open() -> Result<Self, OpenError> {
+        Err(OpenError::Unsupported)
+    }
+    fn display(&self, _uyvy: &[u8]) -> Result<(), i32> {
+        let _ = &self.name;
+        Err(-1)
+    }
+}
+
+/// Fixed-point BT.709 limited-range tables (16 fractional bits): each R', G', B' code value's
+/// contribution to Y' (offset 16 included in `y_off`), Cb and Cr (ITU-R BT.709-6, Table 4:
+/// Y' = 16 + 219 E'y, Cb = 128 + 224 (E'b - E'y) / 1.8556, Cr = 128 + 224 (E'r - E'y) / 1.5748).
+struct Tables {
+    y: [[i32; 256]; 3],
+    cb: [[i32; 256]; 3],
+    cr: [[i32; 256]; 3],
+}
+
+const FRAC: i32 = 16;
+
+fn tables() -> &'static Tables {
+    static T: std::sync::OnceLock<Tables> = std::sync::OnceLock::new();
+    T.get_or_init(|| {
+        let (kr, kg, kb) = (0.2126f64, 0.7152f64, 0.0722f64);
+        let ky = [kr, kg, kb];
+        // E'b - E'y and E'r - E'y as weights of R', G', B'
+        let kcb = [-kr / 1.8556, -kg / 1.8556, (1.0 - kb) / 1.8556];
+        let kcr = [(1.0 - kr) / 1.5748, -kg / 1.5748, -kb / 1.5748];
+        let fixed = |k: f64, v: usize| (k * v as f64 / 255.0 * f64::from(1 << FRAC)).round() as i32;
+        let mut t = Tables { y: [[0; 256]; 3], cb: [[0; 256]; 3], cr: [[0; 256]; 3] };
+        for c in 0..3 {
+            for v in 0..256 {
+                t.y[c][v] = fixed(219.0 * ky[c], v);
+                t.cb[c][v] = fixed(224.0 * kcb[c], v);
+                t.cr[c][v] = fixed(224.0 * kcr[c], v);
+            }
+        }
+        t
+    })
+}
+
+fn clamp_byte(v: i32) -> u8 {
+    v.clamp(0, 255) as u8
+}
+
+/// Where a `sw` x `sh` picture lands when fitted (aspect kept) inside `dw` x `dh`, centred:
+/// `(x0, y0, w, h)`.
+pub fn fit(sw: usize, sh: usize, dw: usize, dh: usize) -> (usize, usize, usize, usize) {
+    if sw == 0 || sh == 0 || dw == 0 || dh == 0 {
+        return (0, 0, 0, 0);
+    }
+    // w / h = sw / sh, as large as fits
+    let (w, h) = if sw * dh >= sh * dw { (dw, (sh * dw + sw / 2) / sw) } else { ((sw * dh + sh / 2) / sh, dh) };
+    let (w, h) = (w.clamp(1, dw), h.clamp(1, dh));
+    ((dw - w) / 2, (dh - h) / 2, w, h)
+}
+
+/// Black in UYVY (limited range).
+const BLACK: [u8; 4] = [128, 16, 128, 16];
+
+/// Convert an 8-bit R'G'B'A picture (`sw` x `sh`, alpha ignored) to UYVY (`dw` x `dh`, `dw` even,
+/// rows of `dw * 2` bytes) in BT.709 limited range: the picture fitted inside the frame (nearest
+/// neighbour), the rest black. Each pair of pixels shares the average of their chroma. A `src`
+/// shorter than `sw * sh * 4` bytes gives a black frame; `dst` is filled up to its length.
+///
+/// Integer table arithmetic (about 3 ms for a 1080p frame): this runs for every frame sent.
+pub fn rgba_to_uyvy(src: &[u8], sw: usize, sh: usize, dst: &mut [u8], dw: usize, dh: usize) {
+    let valid = sw.checked_mul(sh).and_then(|n| n.checked_mul(4)).is_some_and(|n| src.len() >= n);
+    let (x0, y0, w, h) = if valid { fit(sw, sh, dw, dh) } else { (0, 0, 0, 0) };
+    // source byte offset of each output column within its row, or None for the bars
+    let cols: Vec<Option<usize>> = (0..dw).map(|x| (x >= x0 && x < x0 + w).then(|| ((x - x0) * sw / w).min(sw - 1) * 4)).collect();
+    let t = tables();
+    let px = |row: &[u8], col: Option<usize>| -> [usize; 3] {
+        match col.and_then(|o| row.get(o..o + 3)) {
+            Some(p) => [usize::from(p[0]), usize::from(p[1]), usize::from(p[2])],
+            None => [0; 3],
+        }
+    };
+    let luma = |p: [usize; 3]| clamp_byte(((16 << FRAC) + t.y[0][p[0]] + t.y[1][p[1]] + t.y[2][p[2]] + (1 << (FRAC - 1))) >> FRAC);
+    // the pair's chroma: the sum of both pixels' contributions, halved (rounded)
+    let chroma = |k: &[[i32; 256]; 3], a: [usize; 3], b: [usize; 3]| {
+        let sum = k[0][a[0]] + k[1][a[1]] + k[2][a[2]] + k[0][b[0]] + k[1][b[1]] + k[2][b[2]];
+        clamp_byte(((128 << (FRAC + 1)) + sum + (1 << FRAC)) >> (FRAC + 1))
+    };
+    for (y, out) in dst.chunks_mut(dw * 2).take(dh).enumerate() {
+        let src_row = (y >= y0 && y < y0 + h).then(|| ((y - y0) * sh / h).min(sh - 1)).and_then(|sy| src.get(sy * sw * 4..(sy + 1) * sw * 4));
+        let Some(row) = src_row else {
+            for q in out.as_chunks_mut::<4>().0 {
+                *q = BLACK;
+            }
+            continue;
+        };
+        for (pair, q) in out.as_chunks_mut::<4>().0.iter_mut().enumerate() {
+            let a = px(row, cols.get(pair * 2).copied().flatten());
+            let b = px(row, cols.get(pair * 2 + 1).copied().flatten());
+            *q = [chroma(&t.cb, a, b), luma(a), chroma(&t.cr, a, b), luma(b)];
+        }
+    }
+}
+
+/// SMPTE-style 75 % colour bars (white, yellow, cyan, green, magenta, red, blue), `w` x `h` R'G'B'A:
+/// a test picture for checking the output without a project.
+pub fn color_bars(w: usize, h: usize) -> OwnedRgba {
+    const BARS: [[u8; 3]; 7] = [[191, 191, 191], [191, 191, 0], [0, 191, 191], [0, 191, 0], [191, 0, 191], [191, 0, 0], [0, 0, 191]];
+    let mut pixels = Vec::with_capacity(w * h * 4);
+    for _ in 0..h {
+        for x in 0..w {
+            let c = BARS[(x * BARS.len() / w.max(1)).min(BARS.len() - 1)];
+            pixels.extend_from_slice(&[c[0], c[1], c[2], 255]);
+        }
+    }
+    OwnedRgba { width: w, height: h, pixels }
+}
