+/// `decklink-test`: check the DeckLink output (and the TV behind it) without the desktop app.
+async fn cli_decklink_test(a: &Args) {
+    use filmcraft_platform::decklink;
+    if a.opt("--bridge").is_some() {
+        usage("decklink-test is headless; in the app turn on Settings ▸ Playback ▸ Enable External Video Output");
+    }
+    let hold: f64 = finite_opt::<f64>(a, "--hold").unwrap_or(10.0).clamp(0.0, 24.0 * 3600.0);
+    let picture: std::sync::Arc<dyn decklink::RgbaPicture> = if a.opt("--project").is_some() || a.flag("--demo") {
+        let Backend::Local(mut s) = Backend::open(a) else { usage("decklink-test is headless") };
+        let secs: f64 = finite_opt(a, "--seconds").unwrap_or(0.0);
+        let scale: f32 = finite_opt(a, "--scale").unwrap_or(1.0);
+        s.set_playhead(filmcraft_time::Tick::from_seconds_f64(secs));
+        let (img, offline) = render_at_playhead(&s, scale).unwrap_or_else(|e| fail(e));
+        let offline: Vec<Value> = offline.iter().filter_map(|o| serde_json::to_value(o).ok()).collect();
+        check_offline(a, &offline, "decklink-test");
+        std::sync::Arc::new(decklink::OwnedRgba { width: img.w, height: img.h, pixels: img.over_black_rgba8() })
+    } else {
+        std::sync::Arc::new(decklink::color_bars(decklink::WIDTH, decklink::HEIGHT))
+    };
+    let out = decklink::Output::open().unwrap_or_else(|e| fail(format!("decklink-test: {e}")));
+    let (w, h) = picture.size();
+    diag(format_args!("decklink-test: showing a {w}x{h} picture on {} (1080p25) for {hold:.0} s", out.name()));
+    out.send(picture);
+    std::thread::sleep(std::time::Duration::from_secs_f64(hold));
+    let (shown, failed) = out.counts();
+    drop(out);
+    if shown == 0 || failed > 0 {
+        fail(format!("decklink-test: the card took {shown} picture(s) and refused {failed}"));
+    }
+    diag(format_args!("decklink-test: done ({shown} picture shown)"));
+}
+
+/// `decklink-bench`: where External Video Output's time goes, per frame.
+fn cli_decklink_bench(a: &Args) {
+    use filmcraft_platform::decklink;
+    use std::time::{Duration, Instant};
+    let Backend::Local(mut s) = Backend::open(a) else { usage("decklink-bench is headless") };
+    let active = s.active_sequence().map(|q| q as *const _);
+    let Some(seq) = s.project.sequences().map(|i| i.id).find(|id| s.project.sequence(*id).map(|q| q as *const _) == active) else {
+        usage("decklink-bench needs --project or --demo")
+    };
+    let (w, h, rate) = s.active_sequence().map(|q| (q.settings.width, q.settings.height, q.settings.frame_rate)).unwrap_or_else(|| usage("no sequence"));
+    let n: i64 = finite_opt::<f64>(a, "--frames").unwrap_or(50.0).clamp(1.0, 10_000.0) as i64;
+    let start = rate.frame_at(filmcraft_time::Tick::from_seconds_f64(finite_opt::<f64>(a, "--seconds").unwrap_or(0.0)));
+    let scale = (decklink::WIDTH as f32 / w.max(1) as f32).min(decklink::HEIGHT as f32 / h.max(1) as f32).min(1.0);
+    let ms = |d: Duration, n: i64| d.as_secs_f64() * 1000.0 / n.max(1) as f64;
+    outln!("sequence {w}x{h} @ {:.3} fps, output scale {scale}, {n} frames from frame {start}", rate.as_f64());
+    // 1. CPU render (the first version's path)
+    let mut cpu = Duration::ZERO;
+    let mut last = None;
+    for f in start..start + n {
+        s.set_playhead(rate.tick_of(f));
+        let t = Instant::now();
+        let (img, _) = render_at_playhead(&s, scale).unwrap_or_else(|e| fail(e));
+        let px = img.over_black_rgba8();
+        cpu += t.elapsed();
+        last = Some((img.w, img.h, px));
+    }
+    outln!("cpu render + rgba8:      {:7.2} ms/frame", ms(cpu, n));
+    // 2. GPU composite + read-back on the off-screen device
+    match filmcraft_gpu::ExportRenderer::new() {
+        Some(mut r) => {
+            let provider = s.media.provider(s.project.clone(), s.services.clone());
+            let opts = filmcraft_render::RenderOptions { scale, captions: true, ..Default::default() };
+            let mut gpu = Duration::ZERO;
+            for f in start..start + n {
+                let t = Instant::now();
+                let out = r.render_rgba8(&s.project, seq, rate.tick_of(f), opts, &provider);
+                gpu += t.elapsed();
+                if out.is_none() {
+                    outln!("gpu: frame {f} fell back (device failed)");
+                }
+            }
+            outln!("gpu plan+composite+read: {:7.2} ms/frame (decode included)", ms(gpu, n));
+        }
+        None => outln!("gpu: no off-screen device"),
+    }
+    // 3. conversion alone
+    let (lw, lh, px) = last.unwrap_or((1, 1, vec![0; 4]));
+    let mut uyvy = vec![0u8; decklink::ROW_BYTES * decklink::HEIGHT];
+    let t = Instant::now();
+    for _ in 0..n {
+        decklink::rgba_to_uyvy(&px, lw, lh, &mut uyvy, decklink::WIDTH, decklink::HEIGHT);
+    }
+    outln!("rgba -> uyvy:            {:7.2} ms/frame", ms(t.elapsed(), n));
+    // 4. the card at 25 fps
+    if a.flag("--no-card") {
+        return;
+    }
+    match decklink::Output::open() {
+        Ok(out) => {
+            let pic: std::sync::Arc<dyn decklink::RgbaPicture> = std::sync::Arc::new(decklink::OwnedRgba { width: lw, height: lh, pixels: px });
+            let t0 = Instant::now();
+            for i in 0..n {
+                out.send(pic.clone());
+                let due = t0 + Duration::from_millis(40 * (i as u64 + 1));
+                std::thread::sleep(due.saturating_duration_since(Instant::now()));
+            }
+            let st = out.stats();
+            drop(out);
+            outln!(
+                "card ({} sent at 25 fps): shown {} failed {}, convert {:.2} ms, push {:.2} ms per frame",
+                n,
+                st.shown,
+                st.failed,
+                ms(st.convert, st.shown.max(1) as i64),
+                ms(st.display, st.shown.max(1) as i64)
+            );
+        }
+        Err(e) => outln!("card: {e}"),
+    }
+}
