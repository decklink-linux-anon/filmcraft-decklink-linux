+/// Convert limited-range BT.709 UYVY (`w` even, `w * h * 2` bytes) to full-range 8-bit R'G'B'
+/// (`w * h * 3` bytes, packed, no alpha). The inverse of [`rgba_to_uyvy`] / [`rgba_to_uyvy_with`]
+/// without undoing a transfer: mid-tones stay in the encoded domain recorded as `gamma` in a
+/// snapshot sidecar. A `src` shorter than one frame, or a `dst` shorter than the RGB size, is
+/// left untouched. Each pair of pixels shares the stored chroma.
+pub fn uyvy_to_rgb(src: &[u8], w: usize, h: usize, dst: &mut [u8]) {
+    if w == 0 || h == 0 || w % 2 != 0 {
+        return;
+    }
+    let Some(src_n) = w.checked_mul(h).and_then(|n| n.checked_mul(2)) else {
+        return;
+    };
+    let Some(dst_n) = w.checked_mul(h).and_then(|n| n.checked_mul(3)) else {
+        return;
+    };
+    if src.len() < src_n || dst.len() < dst_n {
+        return;
+    }
+    let to_byte = |v: f64| (v * 255.0).round().clamp(0.0, 255.0) as u8;
+    for y in 0..h {
+        let row = &src[y * w * 2..(y + 1) * w * 2];
+        for (pair, q) in row.chunks_exact(4).enumerate() {
+            let (cb, y0, cr, y1) = (q[0], q[1], q[2], q[3]);
+            let decode = |luma: u8| {
+                let ey = (f64::from(luma) - 16.0) / 219.0;
+                let pb = (f64::from(cb) - 128.0) / 224.0;
+                let pr = (f64::from(cr) - 128.0) / 224.0;
+                let er = ey + 1.5748 * pr;
+                let eb = ey + 1.8556 * pb;
+                let eg = (ey - 0.2126 * er - 0.0722 * eb) / 0.7152;
+                [to_byte(er), to_byte(eg), to_byte(eb)]
+            };
+            let o = (y * w + pair * 2) * 3;
+            dst[o..o + 3].copy_from_slice(&decode(y0));
+            dst[o + 3..o + 6].copy_from_slice(&decode(y1));
+        }
+    }
+}
+
