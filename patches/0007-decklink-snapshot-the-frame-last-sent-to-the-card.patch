+//! Write an External Video Output snapshot: the UYVY buffer last pushed to a DeckLink card, a
+//! JSON sidecar, and a PNG decoded back to full-range R'G'B'.
+
+use std::fs;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use super::{Transfer, uyvy_to_rgb};
+
+/// What to write next to the raw UYVY (see [`write_snapshot`]).
+pub struct SnapshotSpec<'a> {
+    pub uyvy: &'a [u8],
+    pub width: usize,
+    pub height: usize,
+    pub transfer: Transfer,
+    /// When the buffer was pushed to the card.
+    pub pushed_at: SystemTime,
+    /// The sequence frame number last sent, if known.
+    pub frame: Option<i64>,
+    /// The same instant as a timecode string, if known.
+    pub timecode: Option<&'a str>,
+    /// 1-based count of pictures handed to the card, including this one.
+    pub output_frame: u64,
+    /// Whether the card accepted this picture.
+    pub accepted: bool,
+}
+
+/// Paths of the three files [`write_snapshot`] wrote.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SnapshotPaths {
+    pub uyvy: PathBuf,
+    pub json: PathBuf,
+    pub png: PathBuf,
+}
+
+impl Transfer {
+    /// The Settings value (`playback.transmitGamma`) for this transfer.
+    pub fn as_pref(self) -> &'static str {
+        match self {
+            Self::AsIs => "asIs",
+            Self::SrgbToBt1886 => "srgbToBt1886",
+        }
+    }
+}
+
+/// Write `spec` to `dest`, a folder or a file stem (a `.uyvy` / `.json` / `.png` suffix is
+/// stripped). The folder is created if needed. An explicit stem is overwritten; a generated name
+/// in a folder is made unique. Returns the three paths.
+pub fn write_snapshot(dest: &Path, spec: &SnapshotSpec<'_>) -> Result<SnapshotPaths, String> {
+    if spec.width == 0 || spec.height == 0 || spec.width % 2 != 0 {
+        return Err("snapshot width must be a positive even number".into());
+    }
+    let need = spec.width.checked_mul(spec.height).and_then(|n| n.checked_mul(2)).ok_or("snapshot size overflows")?;
+    if spec.uyvy.len() < need {
+        return Err("UYVY buffer is shorter than width × height × 2".into());
+    }
+    let stem = resolve_stem(dest, spec.pushed_at, spec.frame)?;
+    if let Some(dir) = stem.parent().filter(|p| !p.as_os_str().is_empty()) {
+        fs::create_dir_all(dir).map_err(|e| format!("cannot create {}: {e}", dir.display()))?;
+    }
+    let uyvy = with_ext(&stem, "uyvy");
+    let json = with_ext(&stem, "json");
+    let png = with_ext(&stem, "png");
+    fs::write(&uyvy, &spec.uyvy[..need]).map_err(|e| format!("cannot write {}: {e}", uyvy.display()))?;
+    let mut json_file = fs::File::create(&json).map_err(|e| format!("cannot write {}: {e}", json.display()))?;
+    json_file.write_all(sidecar_json(spec).as_bytes()).map_err(|e| format!("cannot write {}: {e}", json.display()))?;
+    let mut rgb = vec![0u8; spec.width * spec.height * 3];
+    uyvy_to_rgb(&spec.uyvy[..need], spec.width, spec.height, &mut rgb);
+    write_png(&png, spec.width as u32, spec.height as u32, &rgb)?;
+    Ok(SnapshotPaths { uyvy, json, png })
+}
+
+/// UTC `YYYYMMDDTHHMMSSZ` for generated file names.
+pub fn filename_stamp(t: SystemTime) -> String {
+    let (y, mon, d, h, min, s) = civil_utc(unix_secs(t));
+    format!("{y:04}{mon:02}{d:02}T{h:02}{min:02}{s:02}Z")
+}
+
+/// RFC 3339 UTC (`2024-02-29T00:00:00Z`).
+pub fn rfc3339_utc(t: SystemTime) -> String {
+    let (y, mon, d, h, min, s) = civil_utc(unix_secs(t));
+    format!("{y:04}-{mon:02}-{d:02}T{h:02}:{min:02}:{s:02}Z")
+}
+
+/// Civil UTC date and time of `secs` seconds since the Unix epoch.
+pub fn civil_utc(secs: u64) -> (i32, u32, u32, u32, u32, u32) {
+    let tod = (secs % 86_400) as u32;
+    let (h, min, s) = (tod / 3_600, (tod % 3_600) / 60, tod % 60);
+    // Howard Hinnant's civil-from-days (days since 1970-01-01).
+    let z = (secs / 86_400) as i64 + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = (z - era * 146_097) as u64;
+    let yoe = (doe - doe / 1_460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe as i64 + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = (doy - (153 * mp + 2) / 5 + 1) as u32;
+    let mon = (if mp < 10 { mp + 3 } else { mp - 9 }) as u32;
+    let y = (if mon <= 2 { y + 1 } else { y }) as i32;
+    (y, mon, d, h, min, s)
+}
+
+fn unix_secs(t: SystemTime) -> u64 {
+    t.duration_since(UNIX_EPOCH).unwrap_or_default().as_secs()
+}
+
+fn with_ext(stem: &Path, ext: &str) -> PathBuf {
+    let mut p = stem.as_os_str().to_os_string();
+    p.push(".");
+    p.push(ext);
+    PathBuf::from(p)
+}
+
+fn is_snapshot_ext(path: &Path) -> bool {
+    path.extension().and_then(|e| e.to_str()).is_some_and(|e| matches!(e.to_ascii_lowercase().as_str(), "uyvy" | "json" | "png"))
+}
+
+fn resolve_stem(dest: &Path, at: SystemTime, frame: Option<i64>) -> Result<PathBuf, String> {
+    let dir_hint = dest.as_os_str().to_string_lossy().ends_with(std::path::MAIN_SEPARATOR) || dest.as_os_str().is_empty();
+    let as_dir = dir_hint || dest.is_dir();
+    if as_dir {
+        fs::create_dir_all(dest).map_err(|e| format!("cannot create {}: {e}", dest.display()))?;
+        let mut base = format!("filmcraft-decklink-{}", filename_stamp(at));
+        if let Some(f) = frame {
+            base = format!("{base}-f{f}");
+        }
+        return Ok(unique_stem(dest, &base));
+    }
+    let stem = if is_snapshot_ext(dest) { dest.with_extension("") } else { dest.to_path_buf() };
+    if stem.as_os_str().is_empty() {
+        return Err("snapshot path is empty".into());
+    }
+    Ok(stem)
+}
+
+fn unique_stem(dir: &Path, base: &str) -> PathBuf {
+    let taken = |stem: &Path| ["uyvy", "json", "png"].iter().any(|ext| with_ext(stem, ext).exists());
+    let first = dir.join(base);
+    if !taken(&first) {
+        return first;
+    }
+    for i in 2..10_000 {
+        let cand = dir.join(format!("{base}-{i}"));
+        if !taken(&cand) {
+            return cand;
+        }
+    }
+    dir.join(format!("{base}-{}", unix_secs(SystemTime::now())))
+}
+
+fn sidecar_json(spec: &SnapshotSpec<'_>) -> String {
+    let mut s = String::new();
+    s.push_str("{\n");
+    field(&mut s, "width", &spec.width.to_string(), false);
+    field(&mut s, "height", &spec.height.to_string(), false);
+    field(&mut s, "pixelFormat", &json_str("UYVY"), false);
+    field(&mut s, "range", &json_str("limited"), false);
+    field(&mut s, "matrix", &json_str("BT.709"), false);
+    field(&mut s, "gamma", &json_str(spec.transfer.as_pref()), false);
+    field(&mut s, "timestamp", &json_str(&rfc3339_utc(spec.pushed_at)), false);
+    match spec.frame {
+        Some(f) => field(&mut s, "frame", &f.to_string(), false),
+        None => field(&mut s, "frame", "null", false),
+    }
+    match spec.timecode {
+        Some(t) => field(&mut s, "timecode", &json_str(t), false),
+        None => field(&mut s, "timecode", "null", false),
+    }
+    field(&mut s, "outputFrame", &spec.output_frame.to_string(), false);
+    field(&mut s, "accepted", if spec.accepted { "true" } else { "false" }, true);
+    s.push_str("}\n");
+    s
+}
+
+fn field(s: &mut String, key: &str, value: &str, last: bool) {
+    s.push_str("  ");
+    s.push_str(&json_str(key));
+    s.push_str(": ");
+    s.push_str(value);
+    s.push_str(if last { "\n" } else { ",\n" });
+}
+
+fn json_str(s: &str) -> String {
+    let mut out = String::from("\"");
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+fn write_png(path: &Path, width: u32, height: u32, rgb: &[u8]) -> Result<(), String> {
+    let file = fs::File::create(path).map_err(|e| format!("cannot write {}: {e}", path.display()))?;
+    let mut encoder = png::Encoder::new(file, width, height);
+    encoder.set_color(png::ColorType::Rgb);
+    encoder.set_depth(png::BitDepth::Eight);
+    let mut writer = encoder.write_header().map_err(|e| format!("cannot write {}: {e}", path.display()))?;
+    writer.write_image_data(rgb).map_err(|e| format!("cannot write {}: {e}", path.display()))
+}
