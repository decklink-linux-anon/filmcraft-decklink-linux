diff --git a/crates/ui-egui/src/transmit_snapshot.rs b/crates/ui-egui/src/transmit_snapshot.rs
new file mode 100644
index 00000000..07337ab4
--- /dev/null
+++ b/crates/ui-egui/src/transmit_snapshot.rs
@@ -0,0 +1,150 @@
+//! `transmit.snapshot`: save the UYVY frame last pushed to External Video Output.
+//!
+//! Invoked from the control bridge (`engine.execute` / `ui.menu.invoke`) and from Settings ▸
+//! Playback ▸ Save the frame on the card. Optional `path` is a folder or a file stem; otherwise
+//! [`default_snapshot_dir`] or `playback.transmitSnapshotFolder` is used.
+
+use std::path::PathBuf;
+
+use serde_json::{Value, json};
+
+use crate::FilmcraftApp;
+use crate::hooks::SnapshotInfo;
+
+/// Folder used when `playback.transmitSnapshotFolder` is empty: `~/Pictures/filmcraft-decklink-snapshots`.
+pub const DEFAULT_FOLDER_NAME: &str = "filmcraft-decklink-snapshots";
+
+/// `~/Pictures/filmcraft-decklink-snapshots`, or `filmcraft-decklink-snapshots` if the home
+/// directory is not known. Does not create the folder.
+pub fn default_snapshot_dir() -> PathBuf {
+    match filmcraft_engine::media_browser::std_home_dir() {
+        Some(home) => PathBuf::from(home).join("Pictures").join(DEFAULT_FOLDER_NAME),
+        None => PathBuf::from(DEFAULT_FOLDER_NAME),
+    }
+}
+
+/// The folder preference, or the default when it is empty (whitespace only counts as empty).
+/// The returned path ends in a separator so a folder that does not exist yet is still created
+/// and written into, not used as a file stem (`<folder>.uyvy` beside it).
+pub fn snapshot_folder(pref: &str) -> PathBuf {
+    let p = pref.trim();
+    as_folder(if p.is_empty() { default_snapshot_dir() } else { expand_home(p) })
+}
+
+fn expand_home(p: &str) -> PathBuf {
+    if let Some(rest) = p.strip_prefix("~/") {
+        if let Some(home) = filmcraft_engine::media_browser::std_home_dir() {
+            return PathBuf::from(home).join(rest);
+        }
+    }
+    if p == "~" {
+        if let Some(home) = filmcraft_engine::media_browser::std_home_dir() {
+            return PathBuf::from(home);
+        }
+    }
+    PathBuf::from(p)
+}
+
+/// Mark `path` as a folder for [`filmcraft_platform::decklink::snapshot::write_snapshot`]: a
+/// trailing separator makes a missing folder be created, instead of being used as a file stem.
+fn as_folder(path: PathBuf) -> PathBuf {
+    let lossy = path.as_os_str().to_string_lossy();
+    if lossy.is_empty() || lossy.ends_with(std::path::MAIN_SEPARATOR) {
+        path
+    } else {
+        let mut s = path.into_os_string();
+        s.push(std::path::MAIN_SEPARATOR.to_string());
+        PathBuf::from(s)
+    }
+}
+
+/// Where the three snapshot files should be written. `path` (the command argument) wins over the
+/// folder preference: a directory, or a path ending in a separator, is a folder (a unique name is
+/// generated inside it); any other path is a file stem (`.uyvy` / `.json` / `.png` are stripped
+/// by the writer). With no `path`, this is the folder preference or [`default_snapshot_dir`],
+/// always as a folder (a missing one is created at write time).
+pub fn resolve_dest(path: Option<&str>, folder_pref: &str) -> PathBuf {
+    match path.map(str::trim).filter(|p| !p.is_empty()) {
+        Some(p) => expand_home(p),
+        None => snapshot_folder(folder_pref),
+    }
+}
+
+/// Save the frame last pushed to the open External Video Output. `params.path` is optional.
+pub fn run(app: &mut FilmcraftApp, params: &Value) -> Result<Value, String> {
+    let out = app.transmit.output().ok_or_else(|| "External Video Output is not open".to_string())?;
+    if out.last_pushed().is_none() {
+        return Err("no External Video Output frame has been sent yet".into());
+    }
+    let path = params.get("path").and_then(Value::as_str);
+    let frame = app.transmit.last_key().map(|k| k.frame);
+    let dest = resolve_dest(path, &app.session.prefs.playback.transmit_snapshot_folder);
+    let timecode = frame.map(|f| {
+        let seq = app.session.active_sequence();
+        let rate = seq.map(|s| s.settings.frame_rate).unwrap_or_default();
+        let drop = seq.is_some_and(|s| s.settings.drop_frame);
+        filmcraft_time::format_timecode_frames(f, rate, drop)
+    });
+    let info = SnapshotInfo { frame, timecode };
+    let paths = out.snapshot(&dest, &info)?;
+    app.ui.status = format!("Saved the External Video Output frame to {}", paths.png.display());
+    Ok(json!({
+        "uyvy": paths.uyvy,
+        "json": paths.json,
+        "png": paths.png,
+    }))
+}
+
+/// A success message for the Settings dialog.
+pub fn status_message(result: &Value) -> String {
+    match result.get("png").and_then(Value::as_str).or_else(|| result.get("uyvy").and_then(Value::as_str)) {
+        Some(p) => format!("Saved the External Video Output frame to {p}"),
+        None => "Saved the External Video Output frame".into(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::Path;
+
+    #[test]
+    fn an_empty_preference_uses_pictures_under_home() {
+        let dir = snapshot_folder("");
+        assert!(dir.ends_with(Path::new("Pictures").join(DEFAULT_FOLDER_NAME)) || dir.ends_with(DEFAULT_FOLDER_NAME));
+        assert_eq!(snapshot_folder("   ").as_os_str(), dir.as_os_str());
+    }
+
+    fn folder_path(p: &str) -> PathBuf {
+        as_folder(PathBuf::from(p))
+    }
+
+    #[test]
+    fn an_explicit_folder_preference_is_used_as_a_folder() {
+        assert_eq!(snapshot_folder("/var/tmp/snaps"), folder_path("/var/tmp/snaps"));
+        assert!(snapshot_folder("/var/tmp/snaps").as_os_str().to_string_lossy().ends_with(std::path::MAIN_SEPARATOR));
+    }
+
+    #[test]
+    fn a_path_argument_wins_over_the_preference() {
+        assert_eq!(resolve_dest(Some("/tmp/grade-01"), "/var/pref"), PathBuf::from("/tmp/grade-01"));
+    }
+
+    #[test]
+    fn no_path_argument_uses_the_preference_folder() {
+        assert_eq!(resolve_dest(None, "/var/tmp/snaps"), folder_path("/var/tmp/snaps"));
+        assert_eq!(resolve_dest(Some("  "), "/var/tmp/snaps"), folder_path("/var/tmp/snaps"));
+    }
+
+    #[test]
+    fn a_missing_preference_folder_is_not_used_as_a_file_stem() {
+        let dir = std::env::temp_dir().join(format!("filmcraft-decklink-snap-pref-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        assert!(!dir.exists());
+        let dest = snapshot_folder(dir.to_str().expect("temp path is utf-8"));
+        assert!(dest.as_os_str().to_string_lossy().ends_with(std::path::MAIN_SEPARATOR));
+        assert!(!dest.is_dir());
+        // write_snapshot treats a trailing separator as a folder and creates it.
+        assert!(!dir.as_os_str().to_string_lossy().ends_with(std::path::MAIN_SEPARATOR));
+    }
+}
