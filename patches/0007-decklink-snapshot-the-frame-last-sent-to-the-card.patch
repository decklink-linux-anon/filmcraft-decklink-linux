+    fn last_pushed(&self) -> Option<PushedOutput> {
+        self.0.last_pushed().map(|f| PushedOutput {
+            uyvy: f.uyvy,
+            width: f.width,
+            height: f.height,
+            transfer: match f.transfer {
+                decklink::Transfer::AsIs => OutputTransfer::AsIs,
+                decklink::Transfer::SrgbToBt1886 => OutputTransfer::SrgbToBt1886,
+            },
+            pushed_at: f.pushed_at,
+            output_frame: f.index,
+            accepted: f.accepted,
+        })
+    }
+    fn snapshot(&self, dest: &Path, info: &SnapshotInfo) -> Result<SnapshotPaths, String> {
+        let frame = self.0.last_pushed().ok_or_else(|| "no External Video Output frame has been sent yet".to_string())?;
+        let paths = decklink::write_snapshot(
+            dest,
+            &decklink::SnapshotSpec {
+                uyvy: &frame.uyvy,
+                width: frame.width,
+                height: frame.height,
+                transfer: frame.transfer,
+                pushed_at: frame.pushed_at,
+                frame: info.frame,
+                timecode: info.timecode.as_deref(),
+                output_frame: frame.index,
+                accepted: frame.accepted,
+            },
+        )?;
+        Ok(SnapshotPaths { uyvy: paths.uyvy, json: paths.json, png: paths.png })
+    }
 }
 
